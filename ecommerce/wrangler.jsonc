{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The public website, built for Workers by OpenNext: npm run deploy
  "name": "al-hayat-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Resizes product photos for /_next/image (Cloudflare Images).
  "images": { "binding": "IMAGES" },
  "vars": {
    // The ERP backend Worker (backend/wrangler.jsonc), ending in /api/v1.
    // The shop reads it live on every page: there is no cache to refresh.
    "ERP_API_URL": "https://al-hayat-api.biggestfunofpes.workers.dev/api/v1"
  }
  // Secret (never in this file): npx wrangler secret put STOREFRONT_API_KEY
  // IMAGE_HOSTNAME and NEXT_PUBLIC_* are read at build time: put them in
  // .env.production (or the build environment) before `npm run deploy`.
}
