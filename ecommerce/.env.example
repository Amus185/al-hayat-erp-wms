# Copy to .env.local for development. Never commit real values.

# Where the ERP backend lives (server-side only).
ERP_API_URL=http://localhost:3000/api/v1

# Must equal STOREFRONT_API_KEY on the ERP backend. Server-side only: never prefix with NEXT_PUBLIC_.
STOREFRONT_API_KEY=

# Hostname that serves product photos (the R2 bucket's public domain), e.g. photos.example.com
IMAGE_HOSTNAME=

# Public settings (visible in the browser by design)
NEXT_PUBLIC_SITE_NAME=Al Hayat Furniture
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_CONTACT_PHONE=
