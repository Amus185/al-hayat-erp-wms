{
  "name": "@al-hayat/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "deploy": "vite build && node ../workers-api/node_modules/wrangler/bin/wrangler.js pages deploy dist --project-name=al-hayat-erp --commit-dirty=true",
    "deploy:backend": "node ../workers-api/node_modules/wrangler/bin/wrangler.js deploy --config ../workers-api/wrangler.toml"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "recharts": "^3.10.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
