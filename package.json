{
  "name": "al-hayat-erp-wms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "web",
    "mobile"
  ],
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:web": "npm --workspace web run dev",
    "dev:mobile": "npm --workspace mobile run start",
    "build:backend": "npm --workspace backend run build",
    "build:web": "npm --workspace web run build",
    "build": "npm --workspace backend run build && npm --workspace web run build"
  }
}

