{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "al-hayat-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-01",
  // node:crypto, pg, and process.env populated from vars and secrets.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // bcrypt password checks at sign-in need more CPU than the Free plan's 10 ms:
  // the Worker must run on Workers Paid.
  "limits": { "cpu_ms": 30000 },

  // Connection pooling in front of Postgres. Create it once with
  //   npx wrangler hyperdrive create al-hayat-db --connection-string="postgres://..."
  // and paste the id it prints here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID",
      // Used by `wrangler dev` only.
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5432/al_hayat_erp"
    }
  ],

  // Uploads for /api/v1/files. Create with: npx wrangler r2 bucket create al-hayat-files
  "r2_buckets": [
    { "binding": "STORAGE", "bucket_name": "al-hayat-files" }
  ],

  "vars": {
    "NODE_ENV": "production",
    // Origins allowed to call the API cross-origin, comma-separated. The staff
    // app calls it same-origin through its Pages proxy and needs no entry.
    "CORS_ORIGINS": "https://al-hayat-erp.pages.dev",
    // Better Auth's base URL: the staff app's origin (/api/auth is proxied there).
    "BETTER_AUTH_URL": "https://al-hayat-erp.pages.dev"
  }
  // Secrets (never in this file), each set with: npx wrangler secret put <NAME>
  //   BETTER_AUTH_SECRET    openssl rand -base64 32 (required; without it every request answers 503)
  //   AGENT_TOKEN_SECRET    32+ random characters, different from BETTER_AUTH_SECRET (AI assistant)
  //   STOREFRONT_API_KEY    24+ random characters (public website's order requests)
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET, R2_PUBLIC_BASE_URL (product photos)
}
