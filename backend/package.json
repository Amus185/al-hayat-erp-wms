{
  "name": "al-hayat-backend-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "tsx src/server.ts",
    "dev:node": "tsx watch src/server.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "db:init": "wrangler d1 execute al-hayat-db --local --file=./schema.sql",
    "db:seed": "wrangler d1 execute al-hayat-db --local --file=./seed.sql"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.5.0",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.3",
    "wrangler": "^4.113.0"
  }
}
