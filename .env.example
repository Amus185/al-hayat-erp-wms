# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# ── Supabase PostgreSQL (Direct Connection) ─────────
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
PG_POOL_SIZE=10

# ── Supabase Client ──────────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=sb_publishable_[YOUR-ANON-KEY]
SUPABASE_STORAGE_BUCKET=erp-files

# ── JWT ─────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-64-char-random-hex-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-64-char-random-hex-string
JWT_REFRESH_EXPIRY=7d

# ── Frontend (Vite) ──────────────────────────────────
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_[YOUR-ANON-KEY]
VITE_API_BASE_URL=http://localhost:3000/api/v1
