# Copy to backend/.env for local runs and scripts (db:migrate). Never commit
# real values. In production these are Cloudflare Worker secrets/vars: see
# docs/DEPLOY_CLOUDFLARE.md.

# ── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL (Layerbase: Connect dialog) ──────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].layerbase.dev/[DATABASE]?sslmode=require

# ── Better Auth ─────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# The staff app's base URL (the API is served same-origin under it)
BETTER_AUTH_URL=http://localhost:5173

# ── AI assistant (32+ characters, different from BETTER_AUTH_SECRET) ──
AGENT_TOKEN_SECRET=

# ── Frontend (Vite) ──────────────────────────────────
VITE_API_BASE_URL=/api/v1
